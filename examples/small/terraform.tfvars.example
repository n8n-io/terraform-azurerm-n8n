# Copy to terraform.tfvars and replace every placeholder.

n8n_domain           = "n8n.example.com"
public_dns_zone_name = "example.com"
n8n_license_key      = "REPLACE_ME_WITH_YOUR_N8N_LICENSE_KEY"

# Offline license activation instead of a key (air-gapped clusters): delete
# the n8n_license_key line above (it defaults to null; do not add a second
# assignment), then uncomment the line below. The Secret must exist in the n8n
# namespace before the n8n Helm release installs or rolls, or the pods cannot
# start.
# n8n_license_cert_secret_ref = { name = "n8n-license-cert", key = "cert" }
# Pin the instance ID the certificate was issued for, if it differs from the
# deployment's derived ID (at least 32 characters):
# n8n_extra_env = [{ name = "N8N_INSTANCE_ID", value = "<instance ID>" }]

# Restrict the AKS API to operator and CI egress addresses in production.
# aks_api_authorized_ip_ranges = ["203.0.113.10/32"]

# Upgrade only the AKS control plane on a version change, and upgrade the node
# pools out of band with `az aks nodepool upgrade`.
# aks_node_pools_follow_cluster_version = false

# Change this if another deployment already uses the same Azure names.
# friendly_name_prefix = "n8nsmall"

# common_tags = {
#   Environment = "production"
#   Owner       = "platform-team"
# }

# Outbound TLS-inspecting proxy (see docs/tls-proxy.md). n8n_extra_env is one
# list: if you also pin N8N_INSTANCE_ID above, merge both into a single
# n8n_extra_env assignment instead of uncommenting two.
# n8n_extra_ca_pem = <<-PEM
# -----BEGIN CERTIFICATE-----
# ...proxy CA certificate...
# -----END CERTIFICATE-----
# PEM
# n8n_extra_env = [
#   { name = "HTTPS_PROXY", value = "http://proxy.corp.example:3128" },
#   { name = "HTTP_PROXY", value = "http://proxy.corp.example:3128" },
#   { name = "NO_PROXY", value = "localhost,127.0.0.1,.svc,.cluster.local,.privatelink.postgres.database.azure.com,.blob.core.windows.net" },
# ]
