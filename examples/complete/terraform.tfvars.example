# Copy this file to terraform.tfvars and fill in your values.

# ── Required ──────────────────────────────────────────────────────────────────

# Public DNS zone name the example creates in Azure DNS (e.g. example.com).
# var.n8n_domain MUST resolve inside this zone — typical pattern is to set
# n8n_domain to a subdomain (n8n.example.com) and public_dns_zone_name to the
# parent (example.com). After `terraform apply`, copy the zone's NS records
# (`terraform output -json public_dns_zone_name_servers`) into your registrar
# to delegate the zone to Azure DNS — Terraform cannot do this upstream step.
public_dns_zone_name = "example.com"

# Fully-qualified domain name n8n is served on. The example writes the
# A-record for this name into the zone above pointing at
# `module.infra.appgw_public_ip_address` — single-apply, no manual DNS step.
# Must be the zone apex itself or a subdomain of public_dns_zone_name.
n8n_domain = "n8n.example.com"

# n8n Enterprise license activation key. Get one at https://n8n.io/pricing.
# `module.workload`'s variables.tf rejects this exact placeholder string —
# replace it before running terraform apply, otherwise validation fails.
n8n_license_key = "REPLACE_ME_WITH_YOUR_N8N_LICENSE_KEY"

# This example uses `modules/tls-self-signed/` to issue a lab-grade
# self-signed listener cert into a shared Key Vault. For production-grade
# Let's Encrypt certs see ../complete-letsencrypt/. To bring your own cert
# (e.g. from DigiCert / Sectigo / your internal PKI), edit main.tf to drop
# `module.tls_self_signed` and pass your existing Key Vault Secret URI
# directly to `module.infra` and `module.workload` as
# `app_gateway_tls_cert_secret_id`.

# ── Optional ──────────────────────────────────────────────────────────────────

# Azure region. Change if you're deploying outside eastus.
# location = "westeurope"

# Lowercase prefix used in every resource name. 2–12 alnum-lowercase chars
# (Azure storage-account naming is the binding constraint — names cap at 24
# chars and must be globally unique across all of Azure).
# friendly_name_prefix = "n8nlab"

# Extra Azure tags applied to the example's resource groups, VNet, DNS zone,
# AND merged into both module.infra and module.workload's `local.common_tags`.
# common_tags = {
#   Environment = "production"
#   Owner       = "platform-team"
# }
