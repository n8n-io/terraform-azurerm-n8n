# Copy to terraform.tfvars and replace every placeholder.

# Served by the private admin Application Gateway. Reachable only from
# inside the VNet or over VPN/peering.
n8n_domain = "n8n.example.com"

# hooks.n8n.example.com is served by the public webhook Application Gateway.
# webhook_subdomain = "hooks"

n8n_license_key = "REPLACE_ME_WITH_YOUR_N8N_LICENSE_KEY"

# Restrict the AKS API to operator and CI egress addresses in production.
# aks_api_authorized_ip_ranges = ["203.0.113.10/32"]

# Narrow the admin gateway further to a VPN pool or peered range. Empty
# (the default) allows any source that can already route to the VNet.
# admin_allowed_cidr_blocks = ["10.20.0.0/16"]

# Set to false to use the cheaper Standard_v2 SKU with no WAF on the public
# webhook gateway.
# create_webhook_waf_policy = false

# Change this if another deployment already uses the same Azure names.
# friendly_name_prefix = "n8nsplit"

# common_tags = {
#   Environment = "production"
#   Owner       = "platform-team"
# }

# Outbound TLS-inspecting proxy (see docs/tls-proxy.md).
# n8n_extra_ca_pem = <<-PEM
# -----BEGIN CERTIFICATE-----
# ...proxy CA certificate...
# -----END CERTIFICATE-----
# PEM
# n8n_extra_env = [
#   { name = "HTTPS_PROXY", value = "http://proxy.corp.example:3128" },
#   { name = "NO_PROXY", value = "localhost,127.0.0.1,.svc,.cluster.local,.privatelink.postgres.database.azure.com,.blob.core.windows.net" },
# ]
